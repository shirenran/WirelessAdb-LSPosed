<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wadb_bg">

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="-48dp"
        android:background="@drawable/bg_blob_cyan"
        android:alpha="0.85" />

    <View
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_gravity="start|top"
        android:layout_marginTop="460dp"
        android:layout_marginStart="-48dp"
        android:background="@drawable/bg_blob_pink"
        android:alpha="0.75" />

    <View
        android:layout_width="12dp"
        android:layout_height="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="128dp"
        android:background="@drawable/bg_petal"
        android:rotation="28" />

    <View
        android:layout_width="10dp"
        android:layout_height="14dp"
        android:layout_gravity="end"
        android:layout_marginTop="410dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_petal"
        android:rotation="170" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/wadb_page_pad"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/wadb_page_pad"
            android:paddingBottom="28dp">

            <!-- Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingEnd="6dp"
                android:paddingBottom="7dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_shadow_pink" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:minHeight="134dp"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="-6dp"
                        android:background="@drawable/bg_tape_cyan"
                        android:rotation="-2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:paddingEnd="100dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="11sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="0.5sp"
                            android:autoSizeTextType="uniform"
                            android:letterSpacing="0.18"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/wadb_subtitle"
                            android:textColor="@color/wadb_pink_soft"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/title_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autoSizeMaxTextSize="26sp"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="2"
                            android:text="@string/wadb_title"
                            android:textColor="@color/wadb_title"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <dev.wirelessadb.autostart.RobotMascotView
                        android:id="@+id/mascot"
                        android:layout_width="108dp"
                        android:layout_height="94dp"
                        android:layout_gravity="end|center_vertical" />
                </FrameLayout>
            </FrameLayout>

            <!-- Status -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:paddingEnd="6dp"
                android:paddingBottom="7dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_shadow_cyan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <View
                        android:layout_width="96dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="-8dp"
                        android:layout_marginTop="-24dp"
                        android:background="@drawable/bg_tape_pink"
                        android:rotation="-3" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/status_eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.16"
                            android:text="@string/status_section_title"
                            android:textColor="@color/wadb_pink_soft"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/status_ready_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/status_eyebrow"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_status_dot">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_zap" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/status_connected"
                                android:textColor="@color/wadb_fg"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/notice_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_notice_chip"
                            android:ellipsize="end"
                            android:maxWidth="160dp"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:text="@string/notice_ready"
                            android:textColor="@color/wadb_cyan_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_mode_panel"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_section_title"
                            android:textColor="@color/wadb_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mode_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/mode_tcp_default"
                            android:textColor="@color/wadb_mode_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clipToPadding="false"
                        android:paddingEnd="3dp"
                        android:paddingBottom="3dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_address_shadow" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_address"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.14"
                                android:text="@string/address_section_title"
                                android:textColor="@color/wadb_cyan_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/address_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:maxLines="2"
                                android:text="@string/address_waiting"
                                android:textColor="@color/wadb_address"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tape_pink"
                    android:rotation="-1" />

                <View
                    android:layout_width="64dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tape_cyan"
                    android:rotation="1" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sparkles" />
            </LinearLayout>

            <!-- Mode TLS -->
            <FrameLayout
                android:id="@+id/mode_tls_shell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingEnd="4dp"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/mode_tls_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_mode_idle_shadow" />

                <LinearLayout
                    android:id="@+id/mode_tls_btn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_mode_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_plate">

                        <ImageView
                            android:id="@+id/mode_tls_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wifi_idle" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/mode_tls_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/mode_tls_option"
                        android:textColor="@color/wadb_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/mode_tls_check"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_white"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Mode TCP -->
            <FrameLayout
                android:id="@+id/mode_tcp_shell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingEnd="4dp"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/mode_tcp_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_mode_selected_shadow" />

                <LinearLayout
                    android:id="@+id/mode_tcp_btn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_mode_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_plate">

                        <ImageView
                            android:id="@+id/mode_tcp_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_link_on_pink" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/mode_tcp_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/mode_tcp_option"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/mode_tcp_check"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_white"
                        android:visibility="visible" />
                </LinearLayout>
            </FrameLayout>

            <!-- Port -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:paddingEnd="3dp"
                android:paddingBottom="4dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_mode_idle_shadow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_mode_idle"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tcp_port_label"
                        android:textColor="@color/wadb_fg"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/port_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:gravity="end|center_vertical"
                        android:hint="@string/tcp_port_hint"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="@color/wadb_fg"
                        android:textColorHint="@color/wadb_muted2"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>
            </FrameLayout>

            <!-- Language -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingEnd="3dp"
                android:paddingBottom="4dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_mode_idle_shadow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_mode_idle"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language_section_title"
                        android:textColor="@color/wadb_fg"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/language_spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:entries="@array/language_options"
                        android:gravity="end|center_vertical"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </FrameLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/action_apply"
                    layout="@layout/include_action_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/action_copy"
                    layout="@layout/include_action_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/action_refresh"
                    layout="@layout/include_action_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Log -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clipToPadding="false"
                android:paddingEnd="6dp"
                android:paddingBottom="7dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_shadow_cream" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:minHeight="300dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <View
                        android:layout_width="144dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="-28dp"
                        android:layout_marginEnd="-20dp"
                        android:background="@drawable/bg_tape_yellow"
                        android:rotation="3" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/log_eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.16"
                            android:text="@string/log_section_title"
                            android:textColor="@color/wadb_pink_soft"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/log_eyebrow"
                            android:layout_marginTop="4dp"
                            android:text="@string/log_section_subtitle"
                            android:textColor="@color/wadb_muted3"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_log_chip"
                            android:fontFamily="monospace"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/log_badge"
                            android:textColor="#837386"
                            android:textSize="10sp" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="174dp">

                        <LinearLayout
                            android:id="@+id/log_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_log_empty"
                            android:gravity="center_horizontal"
                            android:minHeight="174dp"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:visibility="gone">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_log_icon">

                                <ImageView
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_clipboard" />

                                <FrameLayout
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="end|top"
                                    android:layout_marginTop="-8dp"
                                    android:layout_marginEnd="-8dp"
                                    android:background="@drawable/bg_sparkle_chip">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_sparkles" />
                                </FrameLayout>
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/log_empty_title"
                                android:textColor="@color/wadb_fg"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="@string/log_empty_message"
                                android:textColor="@color/wadb_muted2"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ScrollView
                            android:id="@+id/log_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_log_empty"
                            android:minHeight="174dp"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/log_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="4dp"
                                android:textColor="@color/wadb_fg"
                                android:textSize="12sp" />
                        </ScrollView>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="112dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@color/wadb_ink"
                android:alpha="0.7" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
